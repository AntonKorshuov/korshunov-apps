{
    "name":  "mathe-champion-5",
    "private":  true,
    "version":  "1.0.2",
    "type":  "module",
    "main":  "electron/main.cjs",
    "scripts":  {
                    "start":  "electron .",
                    "dev":  "vite",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "electron:dev":  "concurrently \"vite\" \"wait-on tcp:5173 \u0026\u0026 electron .\"",
                    "electron:pack":  "npm run build \u0026\u0026 electron-builder --dir",
                    "electron:build":  "npm run build \u0026\u0026 electron-builder"
                },
    "dependencies":  {
                         "canvas-confetti":  "^1.9.4",
                         "electron-updater":  "^6.8.11",
                         "lucide-react":  "^1.16.0",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0"
                     },
    "devDependencies":  {
                            "@types/canvas-confetti":  "^1.9.0",
                            "@types/node":  "^22.13.0",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "@vitejs/plugin-react":  "^4.3.4",
                            "autoprefixer":  "^10.4.20",
                            "concurrently":  "^9.1.2",
                            "cross-env":  "^7.0.3",
                            "electron":  "^34.2.0",
                            "electron-builder":  "^25.1.8",
                            "postcss":  "^8.5.1",
                            "tailwindcss":  "^3.4.17",
                            "typescript":  "~5.7.2",
                            "vite":  "^6.1.0",
                            "wait-on":  "^8.0.2"
                        },
    "build":  {
                  "appId":  "de.mathe.champion5",
                  "productName":  "Mathe-Champion 5",
                  "directories":  {
                                      "output":  "dist-electron"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*"
                            ],
                  "publish":  {
                                  "provider":  "github",
                                  "owner":  "AntonKorshuov",
                                  "repo":  "korshunov-apps"
                              },
                  "win":  {
                              "sign":  null,
                              "target":  [
                                             "dir"
                                         ]
                          }
              }
}